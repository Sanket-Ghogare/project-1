# =============================================================
#  Files and folders NOT copied into the Docker build context.
#  Keeps images small and prevents leaking secrets.
# =============================================================

# ── Node / build artefacts ───────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Next.js build output (will be built inside the container) ─
.next
out
build

# ── Secrets — NEVER bake into the image ──────────────────────
.env
.env.*
!.env.local.example

# ── Version control & editor junk ────────────────────────────
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing & coverage ───────────────────────────────────────
coverage
.nyc_output
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# ── Docs & CI noise ──────────────────────────────────────────
README.md
DEPLOY.md
CHANGELOG.md
.github
.husky

# ── Docker files themselves ──────────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml

# ── Claude / agent metadata ──────────────────────────────────
.claude
AGENTS.md
CLAUDE.md
